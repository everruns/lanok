{
  "name": "@lanok/rpc",
  "version": "0.1.0",
  "description": "Build JSON-RPC 2.0 protocols in TypeScript, on the lanok wire contract.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everruns/lanok.git",
    "directory": "sdks/typescript"
  },
  "keywords": [
    "jsonrpc",
    "protocol",
    "stdio",
    "rpc",
    "everruns"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
