{
  "$defs": {
    "AskParams": {
      "properties": {
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    },
    "AskResult": {
      "properties": {
        "answer": {
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "type": "object"
    },
    "EchoParams": {
      "properties": {
        "shout": {
          "default": false,
          "description": "Uppercase it. Defaults to false, like every optional lanok field, so a\npeer that predates this field still parses.",
          "type": "boolean"
        },
        "text": {
          "description": "The text to transform.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "EchoResult": {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ProgressParams": {
      "properties": {
        "of": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "step": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "step",
        "of"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "messages": {
    "echo": {
      "params": {
        "$ref": "#/$defs/EchoParams"
      },
      "result": {
        "$ref": "#/$defs/EchoResult"
      }
    },
    "echo/progress": {
      "params": {
        "$ref": "#/$defs/ProgressParams"
      }
    },
    "ping": {},
    "ui/ask": {
      "params": {
        "$ref": "#/$defs/AskParams"
      },
      "result": {
        "$ref": "#/$defs/AskResult"
      }
    }
  },
  "protocol": "echo",
  "title": "echo protocol",
  "version": "1.0"
}
